# Copy this file to .env and fill it in. Never commit .env.
#
# The private key that signs deployments. Use a throwaway key for class.
# For local Anvil you can use account #0, which Anvil prints on startup:
PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# RPC endpoints. Leave as-is unless told otherwise.
LOCAL_RPC_URL=http://127.0.0.1:8545
PRISMO_RPC_URL=https://rpc.glassnet.prismo.network/

# Instructor only: how much gas token to send each student (in whole units).
STUDENT_FUND_AMOUNT=2
