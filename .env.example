# Copy this file to .env and fill it in. Never commit .env.
#
# Prismo signer: the private key of YOUR OWN fresh MetaMask account.
# Fund it at https://faucet.glassnet.prismo.network/ (1 USDC per 24h is plenty).
# Leave it empty until you deploy to Prismo. Never use Anvil's key here.
PRIVATE_KEY=

# Local signer. Defaults to Anvil account #0, which Anvil funds on startup.
# Its key is public, so it is only ever used against your local chain.
LOCAL_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# RPC endpoints. Leave as-is unless told otherwise.
LOCAL_RPC_URL=http://127.0.0.1:8545
PRISMO_RPC_URL=https://rpc.glassnet.prismo.network/

# Instructor only: how much gas token make fund-students sends each student (whole units).
STUDENT_FUND_AMOUNT=2
